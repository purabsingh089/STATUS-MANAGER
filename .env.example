BROWSER_USER_DATA_DIR=./data/browser-profile

AUTO_START=false
HEALTH_CHECK_INTERVAL_MS=60000
SERVER_CHECK_INTERVAL_MS=30000
ACCOUNT_SYNC_INTERVAL_MS=300000

RETRY_MAX_ATTEMPTS=5
WEBHOOK_URL=
