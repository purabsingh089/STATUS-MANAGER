NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_PATH=./data/srncloud.db
ENCRYPTION_KEY=
SESSION_SECRET=

DASHBOARD_PASSWORD=
